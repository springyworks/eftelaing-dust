{
  "name": "eftelaing-dust",
  "version": "1.0.0",
  "description": "OSI-layer-plus (7+3) and Maslow pyramid as a coupled wave simulation",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "npm run typecheck && node build.mjs",
    "relay": "esbuild server/relay.ts --bundle --platform=node --format=esm --outfile=.relay/relay.mjs --log-level=warning && node .relay/relay.mjs",
    "mcp": "esbuild server/relay.ts --bundle --platform=node --format=esm --outfile=.relay/relay.mjs --log-level=warning && node .relay/relay.mjs --mcp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@maxgraph/core": "^0.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
